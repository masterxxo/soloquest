# Keep the build context small and secret-free.

# dependencies (reinstalled inside the image)
node_modules
**/node_modules

# build artifacts (regenerated inside the image)
.turbo
**/.turbo
.nuxt
**/.nuxt
.output
**/.output
dist
**/dist

# vcs
.git
.gitignore

# secrets & logs — must never be baked into an image layer
.env
.env.*
!.env.example
*.log
**/*.log

# editor / OS cruft
.DS_Store
.vscode
.idea
